{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "numberOfRuns": 1,
      "url": ["/", "/about/", "/blog/", "/contact/", "/showcase/"],
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
